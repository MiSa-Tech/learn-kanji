type Query {
    # User
    findUserByUsername(username: String!): User
    findAllUsers(pageNum: Int!, pageSize: Int!): [User]!
    # Kanji
    findKanjiByValue(value: String!): Kanji
    findKanjiByJlpt(jlpt: Int!, pageNum: Int!, pageSize: Int!): [Kanji]!
    findKanjiByStrokes(strokes: Int!, pageNum: Int!, pageSize: Int!): [Kanji]!
    findKanjiByGrade(grade: Int!, pageNum: Int!, pageSize: Int!): [Kanji]!
    # Vocabulary
    findVocabularyByOriginal(original: String!): Vocabulary
    findVocabularyByJlpt(jlpt: Int!, paginationInput: PaginationInput = {pageNum: 0, pageSize: 10, ordering: ASC}): [Vocabulary]!
    findVocabularyByFurigana(furigana: String!, paginationInput: PaginationInput = {pageNum: 0, pageSize: 10, ordering: ASC}): [Vocabulary]!
    findVocabularyByMeaning(meaning: String!, paginationInput: PaginationInput = {pageNum: 0, pageSize: 10, ordering: ASC}): [Vocabulary]!
    findAllVocabulary(paginationInput: PaginationInput = {pageNum: 0, pageSize: 10, ordering: ASC}): [Vocabulary]!
    # KanjiResult
    findBestShouldLearnKanji(username: String!, pageNum: Int!, pageSize: Int!): [KanjiResult]!
}

type Mutation {
    createUser(username: String!, password: String!, jlpt: Int): User!
    createKanji(value: String!, strokes: Int, grade: Int, frequency: Int, jlpt: Int, meaning: [String]!, readings_on: [String], readings_kun: [String]): Kanji!
    createVocabulary(original: String!, furigana: [String]!, meaning: [String]!, jlpt: Int): Vocabulary!
    userLearntKanji(username: String!, kanji: String!): User!
    login(username: String!, password: String!): AuthenticationResponse!
}

enum Ordering {
    ASC
    DESC
}

input PaginationInput {
    pageNum: Int!
    pageSize: Int!
    ordering: Ordering!
}

type User {
    id: ID!
    username: String!
    role: String!
    jlpt: Int
    LEARNT_KANJI: [Kanji]
    LEARNT_VOCABULARY: [Vocabulary]
}

type KanjiResult {
    kanji: Kanji!,
    occurrence: Int!
}

type Kanji {
    id: ID!
    value: String!
    strokes: Int
    grade: Int
    frequency: Int
    jlpt: Int
    meaning: [String]!
    readings_on: [String]
    readings_kun: [String]
    PART_OF: [Vocabulary]
}

type Vocabulary {
    id: ID!
    original: String!
    furigana: [String]!
    meaning: [String]!
    jlpt: Int
}

type AuthenticationResponse {
    jwt: String!
    id: String!
    username: String!
    role: String!
}
